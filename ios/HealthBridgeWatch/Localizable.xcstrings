{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Couldn't reach the iPhone app. Open HealthBridge on the watch and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没连上 iPhone 上的 App，在手表上打开 HealthBridge 再试一次"
          }
        }
      }
    },
    "Go ahead, I'll write it all down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说吧，我全都记下来"
          }
        }
      }
    },
    "Saved: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下了：%@"
          }
        }
      }
    },
    "What to log": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要记的内容"
          }
        }
      }
    },
    "Quick log": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口述记录"
          }
        }
      }
    }
  }
}